NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/akash-nextgen-it?retryWrites=true&w=majority
# Use only when the deployment DNS resolver blocks mongodb+srv SRV lookups.
MONGODB_DIRECT_SEEDS=
MONGODB_REPLICA_SET=
CLIENT_URL=https://akashnextgenit.vercel.app
API_URL=http://localhost:5000
ADMIN_URL=https://your-api-domain.example/admin
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Akash NextGen IT <akashnextgenit@gmail.com>
ADMIN_NOTIFICATION_EMAIL=akashnextgenit@gmail.com
UPLOAD_MAX_MB=5
ADMIN_EMAIL=akashnextgenit@gmail.com
ADMIN_PASSWORD=set-only-when-running-npm-run-create-admin
